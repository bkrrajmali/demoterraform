####Cluster Creation
# 1. Variables
RG="AKS"
LOCATION="centralindia"
AKS_NAME="demoaks"

# 2. Resource Group
az group create \
  --name $RG \
  --location $LOCATION

# 3. Create AKS with System Pool
az aks create \
  --resource-group $RG \
  --name $AKS_NAME \
  --location $LOCATION \
  --nodepool-name systempool \
  --node-count 1 \
  --node-vm-size Standard_B2s \
  --enable-node-public-ip \
  --load-balancer-sku standard \
  --generate-ssh-keys

# 4. Add User Pool
az aks nodepool add \
  --resource-group $RG \
  --cluster-name $AKS_NAME \
  --name userpool \
  --mode User \
  --node-count 1 \
  --node-vm-size Standard_B2s \
  --enable-node-public-ip

# 5. Get credentials
az aks get-credentials \
  --resource-group $RG \
  --name $AKS_NAME

# 6. Verify nodes
kubectl get nodes -o wide

# 7. Verify pools
az aks nodepool list \
  --resource-group $RG \
  --cluster-name $AKS_NAME \
  -o table


